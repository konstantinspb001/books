{% extends 'base.html.twig' %}


{% block title %}
   
{% endblock %}

{% block css %}
    <link rel="stylesheet" href="/css/chapter-view.css">
{% endblock %}


{% block main %}

    <!-- MAIN CONTENT -->
    <main class="main-content">
        {# 
        <header class="page-header">
            <div class="page-header-top">
                <div>
                    <h1 class="page-title">
                        {% if section.parent %}
                            {{section.parent.title}} -> 
                        {% endif %}
                            {{section.title}}
                    </h1>
                   
                </div>
                <div class="page-actions">
                    <a href="summary.html?chapter=7" class="btn btn-secondary">📝 Саммари</a>
                    <a href="discussion.html?chapter=7" class="btn btn-secondary">💬 Обсуждение</a>
                </div>
            </div>
        </header>
        #}

        <div class="chapter-view-layout">


            <!-- Text Area -->
            <div class="chapter-text-area">


                <div class="chapter-meta">
                    {# <div class="chapter-meta-num">Глава 7 · Раздел 2</div> #}
                    <h2 class="chapter-meta-title">
                        {{section.title}}
                        {% if archive %} [архив] {% endif %}
                        {% if ideasLink %} [💡] {% endif %}
                    </h2>

                
                    <div class="chapter-meta-info">
                    {% if section.sections|length > 0 %}    
                        <span class="chapter-meta-item">📊 {{section.sections|length}}  разделов</span>
                    {% else %}   

                        <span class="chapter-meta-item">
                            {% if archive %}
                                <div class="chapter-card-actions">
                                    <a href="?archive=0" class="btn btn-secondary btn-sm">Книга</a> > 
                                    <a href="?archive_date={{archive.date}}" class="btn btn-secondary btn-sm">Архив от: {{archive.date}}</a>
                                </div>
                            {% elseif ideasLink %}    
                                <div class="chapter-card-actions">
                                    <a href="?archive=0" class="btn btn-secondary btn-sm">Книга</a> > 
                                    <a href="?ideas=1" class="btn btn-secondary btn-sm">идеи</a>
                                </div>
                            {% elseif recommendation %}    
                                <div class="chapter-card-actions">
                                    <a href="?archive=0" class="btn btn-secondary btn-sm">{{section.title}}</a> > 
                                    <a href="?recommendation={{recommendation.id}}" class="btn btn-secondary btn-sm">
                                        рекомендация от {{recommendation.botName}}
                                    </a>
                                </div>
                            {% else %}    
                            <a href="/section_red/{{section.id}}" class="btn btn-primary" style="padding: 3px 10px 3px 6px;font-size: 11px;">
                                ✏️ Редактировать
                            </a> / 
                            {% set newIdeas = section.data('new_ideas') %}
                            <a href="?ideas=1" class="btn btn-secondary btn-sm">💡 Идеи 
                                [ {{section.ideasNum - newIdeas}}{% if newIdeas %} + <b>{{newIdeas}}{% endif %}</b> ]
                            </a>
                            {% endif %}
                        </span>
                        <span class="chapter-meta-right">
                            <span class="chapter-meta-item">📊 {{section.words}}  слов</span>
                            <span class="chapter-meta-item">🔤 {{section.simbols}} символов</span>
                            {% if section.changetAt %}
                            <span class="chapter-meta-item">📅 {{section.changetAt(true)}}</span>
                            {% endif %}
                        </span>
                        {# <span class="chapter-meta-item"><span class="badge badge-blue">Черновик</span></span> #}
                    {% endif %}
                    </div>
                   
                </div>

                <div class="book-text" style="{% if archive %} background-color: #f8f9fa; {% endif %}">
                    {% if ideasLink %}
                       <p style="background-color: #f1f3f4;">файл с идеями: <a href="{{ideasLink}}" target="_blank">{{ideasLink}}</a><p>
                    {% endif %}    
                         {{html|raw}}
                </div>

                <!-- Chapter Navigation -->
                <div class="chapter-nav">
                    <a href="chapter-view.html?chapter=7&section=1" class="chapter-nav-item prev">
                        <span class="chapter-nav-label">← Предыдущий раздел</span>
                        <span class="chapter-nav-title">7.1 Рассвет перед боем</span>
                    </a>
                    <a href="chapter-view.html?chapter=7&section=3" class="chapter-nav-item next">
                        <span class="chapter-nav-label">Следующий раздел →</span>
                        <span class="chapter-nav-title">7.3 Решение командира</span>
                    </a>
                </div>
            </div>


            <!-- Comments Sidebar -->
            <div class="comments-sidebar">

                <!-- AI Assist -->
                {% if recommendations %}
                <div class="editor-sidebar-section">
                <div class="comments-sidebar-header" style="margin-bottom: 10px;">
                    <div class="comments-sidebar-title">
                        🤖 Рекомендации ИИ <span class="comments-count">6</span>
                    </div>
                    <button class="btn btn-sm btn-ghost">+ Добавить</button>
                </div>
                    <div class="editor-sidebar-body">
                       
                        <div class="ai-assist-actions">
                            {% for recommendation in recommendations %}
                            <a class="ai-assist-btn" href="?recommendation={{recommendation.id}}">
                                <div>
                                    <div class="ai-assist-text" style="color:#000; font-size:15px;">{{recommendation.botName}}</div>
                                    <div class="ai-assist-desc">от {{recommendation.date}} {# | 🔤 6547 символов#}</div>
                                </div>
                            </a>
                            {% endfor %}
                        </div>
                      
                    </div>
                </div>
                {% endif %}
                
                {% if archives %}
                <div class="editor-sidebar-section">
                    <div class="editor-sidebar-header">
                        <span class="editor-sidebar-title">🕐 История</span>
                        <span class="editor-sidebar-toggle">▾</span>
                    </div>

                    <div class="editor-sidebar-body">
                        {% for archive in archives %}
                        <div class="history-item">
                            <div class="history-dot"></div>
                            <div class="history-info">
                                <div class=""><a href="?archive_date={{archive.date}}">Архив от: {{archive.date}}</a></div>
                                
                            </div>
                        </div>
                        {% endfor %}
                        
                    </div>
                </div>
                {% endif %}



                <div class="comments-sidebar-header">
                    <div class="comments-sidebar-title">
                        💬 Комментарии <span class="comments-count">6</span>
                    </div>
                    <button class="btn btn-sm btn-ghost">+ Запросить</button>
                </div>

                <!-- Comment filters -->
                <div class="comment-filters">
                    <a href="chapter-view.html?chapter=7&section=2&agent=all" class="comment-filter active">Все</a>
                    <a href="chapter-view.html?chapter=7&section=2&agent=editor" class="comment-filter">Редактор</a>
                    <a href="chapter-view.html?chapter=7&section=2&agent=critic" class="comment-filter">Критик</a>
                    <a href="chapter-view.html?chapter=7&section=2&agent=writer" class="comment-filter">Писатель</a>
                    <a href="chapter-view.html?chapter=7&section=2&agent=stylist" class="comment-filter">Стилист</a>
                </div>

                <div class="comment-list">
                    <!-- Comment from Editor -->
                    <div class="comment-block editor">
                        <div class="comment-block-header">
                            <div class="avatar avatar-sm avatar-editor">Р</div>
                            <div>
                                <div class="comment-agent-name">Редактор</div>
                                <div class="comment-agent-role">Структура и связность</div>
                            </div>
                            <span class="comment-time">2ч назад</span>
                        </div>
                        <div class="comment-block-body">
                            <p class="comment-text">Отличная динамика в начале раздела. Однако переход от описания стены к диалогу с капитаном можно сделать более плавным. Рекомендую добавить промежуточное предложение, связывающее физические ощущения героя с командой.</p>
                            <div class="comment-ref">📌 «Первая линия, приготовиться!»</div>
                        </div>
                        <div class="comment-block-footer">
                            <button class="comment-action">👍 Полезно</button>
                            <button class="comment-action">💬 Ответить</button>
                            <button class="comment-action">✅ Принять</button>
                        </div>
                    </div>

                    <!-- Comment from Critic -->
                    <div class="comment-block critic">
                        <div class="comment-block-header">
                            <div class="avatar avatar-sm avatar-critic">К</div>
                            <div>
                                <div class="comment-agent-name">Критик</div>
                                <div class="comment-agent-role">Логика и ошибки</div>
                            </div>
                            <span class="comment-time">1ч назад</span>
                        </div>
                        <div class="comment-block-body">
                            <p class="comment-text">Проблема: в Главе 5 установлено, что Лина получила ранение правого плеча. Она не может использовать лук «спокойно» без упоминания боли или компенсации. Это нарушает внутреннюю логику.</p>
                            <div class="comment-ref">📌 «Она стояла... с луком наготове, спокойная»</div>
                        </div>
                        <div class="comment-block-footer">
                            <button class="comment-action">👍 Полезно</button>
                            <button class="comment-action">💬 Ответить</button>
                            <button class="comment-action">✅ Принять</button>
                        </div>
                    </div>

                    <!-- Comment from Stylist -->
                    <div class="comment-block stylist">
                        <div class="comment-block-header">
                            <div class="avatar avatar-sm avatar-stylist">С</div>
                            <div>
                                <div class="comment-agent-name">Стилист</div>
                                <div class="comment-agent-role">Язык и образы</div>
                            </div>
                            <span class="comment-time">45м назад</span>
                        </div>
                        <div class="comment-block-body">
                            <p class="comment-text">Метафора «фосфорический свет» великолепна, но «хитиновые панцири цвета запёкшейся крови» — перегруженный образ. Попробуйте разбить на два предложения или убрать один из дескрипторов.</p>
                            <div class="comment-ref">📌 «Их глаза — если это можно было назвать глазами...»</div>
                        </div>
                        <div class="comment-block-footer">
                            <button class="comment-action">👍 Полезно</button>
                            <button class="comment-action">💬 Ответить</button>
                            <button class="comment-action">✅ Принять</button>
                        </div>
                    </div>

                    <!-- Comment from Writer -->
                    <div class="comment-block writer">
                        <div class="comment-block-header">
                            <div class="avatar avatar-sm avatar-writer">П</div>
                            <div>
                                <div class="comment-agent-name">Писатель</div>
                                <div class="comment-agent-role">Генерация текста</div>
                            </div>
                            <span class="comment-time">30м назад</span>
                        </div>
                        <div class="comment-block-body">
                            <p class="comment-text">Предлагаю вариант для фрагмента «Он ударил»: дополнить внутренним монологом, чтобы усилить эмоциональный вес первого убийства. Например: «Он ударил — и мир замер. Не от предсмертного крика твари, а от тишины внутри. Той пустоты, которая образуется, когда переступаешь черту.»</p>
                        </div>
                        <div class="comment-block-footer">
                            <button class="comment-action">👍 Полезно</button>
                            <button class="comment-action">💬 Ответить</button>
                            <button class="comment-action">📋 Вставить в текст</button>
                        </div>
                    </div>
                </div>

                <!-- Add comment -->
                <div class="add-comment-area">
                    <div class="add-comment-label">Запросить комментарий ИИ</div>
                    <textarea class="add-comment-input" placeholder="Опишите, что хотите обсудить или получить отзыв..."></textarea>
                    <div class="add-comment-actions">
                        <select class="form-select" style="width: auto; padding: 5px 10px; font-size: 12px;">
                            <option>Все агенты</option>
                            <option>Редактор</option>
                            <option>Критик</option>
                            <option>Писатель</option>
                            <option>Стилист</option>
                        </select>
                        <button class="btn btn-primary btn-sm">Отправить</button>
                    </div>
                </div>
            </div>
        </div>
    </main>
  
   
{% endblock %}

