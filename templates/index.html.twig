{% extends 'base.html.twig' %}


{% block title %}
   
{% endblock %}


{% block css %}
    <link rel="stylesheet" href="/css/chapters.css">
{% endblock %}


{% block main %}

  
    <!-- MAIN CONTENT -->
    <main class="main-content">
        <header class="page-header">
            <div class="page-header-top">
                <div>
                    <h1 class="page-title">📑 Главы и разделы</h1>
                    {# <p class="page-subtitle">Структура книги «Хроники Нового Мира»</p> #}
                </div>
                <div class="page-actions">
                    <button class="btn btn-primary">+ Новая глава</button>
                    <a href="/?action=book" target="_blank" class="btn btn-secondary">📒 Вся книга</a>
                    <a href="/?action=sammari" target="_blank" class="btn btn-secondary">📄 Саммари</a>
                    <a href="/book_pdf" target="_blank" class="btn btn-secondary">📄  .PDF</a>
                    {# <button class="btn btn-secondary">⟳ Обновить саммари</button> #}
                </div>
            </div>
        </header>

        <div class="page-body">
            {# 
            <!-- Filters -->
            <div class="filter-bar">
                <span style="font-size: 13px; color: var(--text-secondary); margin-right: 4px;">Статус:</span>
                <a href="chapters.html" class="filter-chip active">Все</a>
                <a href="chapters.html?status=done" class="filter-chip">✅ Завершены</a>
                <a href="chapters.html?status=draft" class="filter-chip">✏️ Черновик</a>
                <a href="chapters.html?status=review" class="filter-chip">🔍 На ревью</a>
                <a href="chapters.html?status=todo" class="filter-chip">📌 К написанию</a>
            </div>
            #}

            <div class="chapters-layout">
                <!-- Tree Navigation -->
                <div class="chapters-tree-panel">
                    <div class="tree-header">
                        <span class="tree-title">Содержание</span>
                        <button class="btn btn-ghost btn-sm">⊞</button>
                    </div>
                    <ul class="tree-list">

                        {% set count = 1 %}
                        {% for section in sections %}
                        <li class="tree-chapter">
                            <div class="tree-chapter-header active">
                                <span class="tree-toggle expanded">▶</span>
                                <span class="tree-chapter-num">{{count}}</span>
                                {{section.title}}
                            </div>
                            <ul class="tree-sections">
                                {% for subSection in section.sections %}
                                    {% if subSection.status != 'archive' %} 
                                        <li>
                                        <a href="{{ path('section', { 'id': subSection.id })}}" class="tree-section-link">
                                            {{subSection.title}}
                                            <span class="tree-section-page"><span style="opacity:0.3;">стр.</span> 
                                            {{subSection.pagesSum}}
                                            </span>
                                        </a>
                                        </li>
                                    {% endif %}

                                {% endfor %}
                                
                            </ul>
                        </li>
                        {% set count = count + 1 %}
                        {% endfor %}

                        {# 
                        <li class="tree-chapter">
                            <div class="tree-chapter-header">
                                <span class="tree-toggle expanded">▶</span>
                                <span class="tree-chapter-num">2</span>
                                Тёмный лес
                            </div>
                            <ul class="tree-sections">
                                <li><a href="chapter-view.html?chapter=2&section=1" class="tree-section-link">2.1 Тропа</a></li>
                                <li><a href="chapter-view.html?chapter=2&section=2" class="tree-section-link">2.2 Встреча с хранителем</a></li>
                            </ul>
                        </li>
                        <li class="tree-chapter">
                            <div class="tree-chapter-header">
                                <span class="tree-toggle">▶</span>
                                <span class="tree-chapter-num">3</span>
                                Скрытое знание
                            </div>
                        </li>
                        <li class="tree-chapter">
                            <div class="tree-chapter-header">
                                <span class="tree-toggle">▶</span>
                                <span class="tree-chapter-num">7</span>
                                Битва за Стену
                            </div>
                        </li>
                        <li class="tree-chapter">
                            <div class="tree-chapter-header">
                                <span class="tree-toggle">▶</span>
                                <span class="tree-chapter-num">8</span>
                                Предательство
                            </div>
                        </li>
                        #}
                    </ul>
                </div>

                <!-- Chapters Cards -->
                <div class="chapters-content" style="margin-bottom: 100px;">
                    
                    {% set count = 1 %}
                    {% for section in sections %}
                    <!-- Chapter 1 -->
                    <div class="chapter-card">

                       
                        <div class="chapter-card-header">
                            <div class="chapter-card-info">
                                {# <div class="chapter-card-num">Глава 1</div> #}
                                <h2 class="chapter-card-title">
                                    <a href="{{ path('section', { 'id': section.id })}}">{{section.title}}</a>
                                </h2>
                                {# <p class="chapter-card-desc">Главный герой просыпается в незнакомом мире и обнаруживает свои способности. Первые шаги в новой реальности...</p> #}
                            </div>
                            <div class="chapter-card-actions">
                                <a href="?markdown={{section.id}}" class="btn btn-secondary btn-sm" target="_blank">📖 Markdown</a>
                                {# <a href="?section={{section.id}}" class="btn btn-ghost btn-sm" target="_blank">📝 Саммари</a> #}
                            </div>
                        </div>
                        <div class="chapter-stats">
                            <div class="chapter-stat">
                                <span class="chapter-stat-icon">📄</span>
                                Страниц: <span class="chapter-stat-value">{{section.pages}}</span>
                            </div>
                            <div class="chapter-stat">
                                <span class="chapter-stat-icon">💭</span>
                                Слов: <span class="chapter-stat-value">{{section.words}}</span>
                            </div>
                            <div class="chapter-stat">
                                <span class="chapter-stat-icon">🔤</span>
                                Символов: <span class="chapter-stat-value">{{section.simbols}}</span>
                            </div>
                            {# 
                            <div class="chapter-stat">
                                <span class="chapter-stat-icon">📅</span>
                                Изменено: <span class="chapter-stat-value">12 дек 2024</span>
                            </div>
                            #}
                            {# 
                            <div class="chapter-stat">
                                <span class="badge badge-green">✅ Завершена</span>
                            </div> 
                            #}
                        </div>
                        <div class="section-list">
                            {% set subCount = 1 %}
                            {% for subSection in section.sections %}


                                <div class="section-item" style="{% if subSection.words < 2 %}background: #dcfce7;{% endif %}{% if subSection.status == 'archive' %} opacity:0.5; padding: 0px;text-decoration: line-through;{% endif %}">
                                    {# <div class="section-status-dot done"></div> #}
                                    <span class="section-num">
                                        {% if subSection.status != 'archive' %}
                                        {{count}}.{{subCount}}
                                        {% endif %}
                                    </span>
                                    <div class="section-info" style="">
                                        <a href="{{ path('section', { 'id': subSection.id })}}" class="section-title-link">
                                            <span class="section-title-text">{{subSection.title}}</span>
                                            <span class="section-meta-inline">
                                                <span class="section-page">{{subSection.pages}} 📄</span>
                                                <span class="section-separator">·</span>
                                                <span class="section-words">{{subSection.words}} слов</span>
                                                <span class="section-separator">·</span>
                                                <span class="section-discussions">{{subSection.simbols}} символов</span>
                                                <span class="section-separator">·</span>
                                               
                                                <span class="section-date">{{subSection.changetAt(true)}}</span>
                                            </span>
                                        </a>
                                    </div>
                                    <div class="section-actions" style="width:100px;">
                                        {% if subSection.ideasNum %}
                                            {% set newIdeas = subSection.data('new_ideas') %}
                                            <a href="{{ path('section', { 'id': subSection.id })}}?ideas=1" class="btn btn-ghost btn-sm">
                                                💡 [ {{subSection.ideasNum - newIdeas}}{% if newIdeas %} + <b>{{newIdeas}}{% endif %}</b> ]
                                            </a>
                                        {% else %}
                                            {# 
                                             <a href="{{ path('section', { 'id': subSection.id })}}?ideas=1" class="btn btn-ghost btn-sm" style="opacity:0.4;">
                                                💡
                                            </a>
                                            #} 
                                        {% endif %}
                                        {# <a href="summary.html?chapter=1&section=1" class="btn btn-ghost btn-sm">📝</a>#}
                                    </div>
                                </div>
                                {% if subSection.status != 'archive' %} {% set subCount = subCount + 1 %} {% endif %}
                                
                            {% endfor %}

                            
                        </div>
                    </div>
                     {% set count = count + 1 %}
                    {% endfor %}

           
                </div>
            </div>
        </div>
    </main>

{% endblock %}

